#!/usr/bin/env bash
set -euo pipefail

repo="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P)"
cd "$repo"
source .github/scripts/mutation-environment
mutation_environment "$repo"
mkdir -p .tox
jobs=${1:-2}
args=(
  --workspace
  --all-features
  --test-tool=nextest
  --jobs "$jobs"
  --jobserver true
  --jobserver-tasks "$jobs"
  --output .tox/mutants
)
if [[ -n ${2:-} ]]; then
  shard=$2
  if [[ ! $shard =~ ^([1-9][0-9]*)/([1-9][0-9]*)$ ]]; then
    printf 'mutation shard must be INDEX/COUNT: %s\n' "$shard" >&2
    exit 2
  fi
  shard_index=${BASH_REMATCH[1]}
  shard_count=${BASH_REMATCH[2]}
  if ((shard_index > shard_count)); then
    printf 'mutation shard index exceeds its count: %s\n' "$shard" >&2
    exit 2
  fi
  args+=(--shard "$((shard_index - 1))/$shard_count" --sharding round-robin)
fi
cargo mutants "${args[@]}"
