#!/usr/bin/env bash
set -euo pipefail

repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P)
cd "$repo"
event=${1:?pass an event name}
changes=${2:-[]}
case "$event" in
  pull_request | push | schedule | workflow_dispatch) ;;
  *)
    printf 'unsupported event: %s\n' "$event" >&2
    exit 2
    ;;
esac
if ! jq -e 'type == "array" and all(.[]; type == "string")' <<<"$changes" >/dev/null 2>&1; then
  printf 'changed paths must be a JSON array of strings\n' >&2
  exit 2
fi

full=false
package_changes='[]'
if [[ $event == pull_request ]]; then
  if jq -e 'any(.[];
    . == "Cargo.toml"
    or . == "Cargo.lock"
    or . == "compose.yaml"
    or . == "justfile"
    or . == "nextest/config.toml"
    or test("^\\.cargo/")
    or test("^rust-toolchain([.]toml)?$")
    or test("^\\.github/scripts/(check-coverage-contracts$|check-lcov-|coverage-|crate-contracts$|package-contract-inputs$|package-source-roots$)")
    or test("^scripts/ci/(affected-contract-packages$|coverage-system-|workspace-package)"))' \
    <<<"$changes" >/dev/null; then
    full=true
  else
    package_changes=$(jq -c '[.[]
      | ltrimstr("./")
      | select(startswith("crates/"))
      | select((test("(^|/)docs/") or test("[.](md|mdx|rst)$")) | not)]' <<<"$changes")
    [[ $package_changes != '[]' ]] || exit 0
  fi
else
  full=true
fi

scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
cargo metadata --no-deps --format-version 1 >"$scratch/metadata.json"
jq -r --argjson changes "$package_changes" --argjson full "$full" '
  .workspace_root as $workspace_root
  | .workspace_members as $workspace_members
  | [.packages[]
      | select(.id as $id | $workspace_members | index($id))
      | {
          id,
          name,
          system: (.metadata["peryx-ci"].kind == "system"),
          root: (.manifest_path | sub("/Cargo.toml$"; "")),
          relative_root: (.manifest_path | sub("/Cargo.toml$"; "") | ltrimstr($workspace_root + "/")),
          dependency_roots: [.dependencies[]? | .path // empty]
        }] as $raw_packages
  | ($raw_packages
      | map(. as $package
          | $package + {
              dependencies: [$raw_packages[]
                | select(.root as $root | $package.dependency_roots | index($root))
                | .id]
            })) as $packages
  | (if $full
      then [$packages[].id]
      else [$changes[] as $path
        | ($packages
            | map(select(.relative_root as $root
                | $path == $root or ($path | startswith($root + "/"))))
            | max_by(.relative_root | length)
            | .id)
        | select(. != null)]
      end | unique)
  | def add_dependents:
      . as $selected
      | ($selected + [$packages[]
          | select(any(.dependencies[]; . as $dependency | $selected | index($dependency) != null))
          | .id]
        | unique);
  until(. as $selected | add_dependents == $selected; add_dependents)
  | . as $selected
  | $packages[]
  | . as $package
  | select(($selected | index($package.id)) != null and ($package.system | not))
  | .name
' "$scratch/metadata.json" | sort -u
