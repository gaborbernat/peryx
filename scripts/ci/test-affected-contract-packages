#!/usr/bin/env bash
set -euo pipefail

repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P)
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
mkdir -p "$scratch/bin"
jq -n --arg root "$repo" '{
  workspace_root: $root,
  workspace_members: ["core", "app", "dev", "build", "leaf", "ecosystem", "system"],
  packages: [
    {id: "core", name: "core", manifest_path: ($root + "/crates/core/Cargo.toml"), metadata: {}, dependencies: []},
    {id: "app", name: "app", manifest_path: ($root + "/crates/app/Cargo.toml"), metadata: {}, dependencies: [
      {name: "core", rename: "renamed-core", kind: null, path: ($root + "/crates/core")}
    ]},
    {id: "dev", name: "dev-consumer", manifest_path: ($root + "/crates/dev/Cargo.toml"), metadata: {}, dependencies: [
      {name: "app", kind: "dev", path: ($root + "/crates/app")}
    ]},
    {id: "build", name: "build-consumer", manifest_path: ($root + "/crates/build/Cargo.toml"), metadata: {}, dependencies: [
      {name: "core", kind: "build", path: ($root + "/crates/core")}
    ]},
    {id: "leaf", name: "leaf", manifest_path: ($root + "/crates/leaf/Cargo.toml"), metadata: {}, dependencies: []},
    {id: "ecosystem", name: "ecosystem", manifest_path: ($root + "/crates/ecosystem/Cargo.toml"), metadata: {}, dependencies: [
      {name: "core", kind: null, path: ($root + "/crates/core")}
    ]},
    {id: "system", name: "system-tests", manifest_path: ($root + "/crates/ecosystem/tests/system-suite/Cargo.toml"),
      metadata: {"peryx-ci": {kind: "system"}}, dependencies: []}
  ]
}' >"$scratch/metadata.json"
cat >"$scratch/bin/cargo" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
[[ $* == 'metadata --no-deps --format-version 1' ]]
cat "$CARGO_METADATA"
EOF
chmod +x "$scratch/bin/cargo"
export CARGO_METADATA="$scratch/metadata.json"
export PATH="$scratch/bin:$PATH"

assert_selection() {
  local expected=$1
  local changes=$2
  local actual
  actual=$(cd "$repo" && scripts/ci/affected-contract-packages pull_request "$changes")
  if [[ $actual != "$expected" ]]; then
    printf 'unexpected selection for %s\nexpected:\n%s\nactual:\n%s\n' "$changes" "$expected" "$actual" >&2
    exit 1
  fi
}

assert_selection leaf '["crates/leaf/src/lib.rs"]'
assert_selection $'app\nbuild-consumer\ncore\ndev-consumer\necosystem' '["crates/core/src/lib.rs"]'
assert_selection '' '["crates/ecosystem/tests/system-suite/tests/system.rs"]'
assert_selection '' '["crates/core/docs/guide.md","README.md"]'
assert_selection '' '[".github/workflows/ci.yml"]'
assert_selection $'app\ndev-consumer\nleaf' \
  '["crates/old-leaf/src/lib.rs","crates/leaf/src/renamed.rs","crates/app/src/deleted.rs"]'

all_contracts=$'app\nbuild-consumer\ncore\ndev-consumer\necosystem\nleaf'
for global_input in Cargo.lock .cargo/config.toml rust-toolchain.toml justfile .github/scripts/crate-contracts; do
  assert_selection "$all_contracts" "[\"$global_input\"]"
done
for event in push schedule workflow_dispatch; do
  actual=$(cd "$repo" && scripts/ci/affected-contract-packages "$event" '[]')
  [[ $actual == "$all_contracts" ]]
done

if (cd "$repo" && scripts/ci/affected-contract-packages pull_request '{bad json' \
  >"$scratch/malformed.stdout" 2>"$scratch/malformed.stderr"); then
  printf 'malformed input passed\n' >&2
  exit 1
fi
[[ ! -s $scratch/malformed.stdout ]]
grep -Fxq 'changed paths must be a JSON array of strings' "$scratch/malformed.stderr"
